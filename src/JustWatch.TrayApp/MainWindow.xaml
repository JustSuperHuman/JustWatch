<Window x:Class="JustWatch.TrayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JustWatch" Height="800" Width="1260" MinHeight="560" MinWidth="840"
        Background="#10151C" Foreground="#E6EDF5" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" Icon="icon.ico" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="WorkspaceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CED8E4" />
            <Setter Property="Background" Value="#202A37" />
            <Setter Property="BorderBrush" Value="#344052" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C3B4C" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#354960" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#89F0C5" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarLink" TargetType="Button" BasedOn="{StaticResource WorkspaceButton}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="SidebarItem" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B6C4D5" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2" /><Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#202B38" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#233C3B" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#365853" />
                                <Setter Property="Foreground" Value="#D9FFF0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#89F0C5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="244" MinWidth="210" MaxWidth="360" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" MinWidth="560" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#161E28" BorderBrush="#2A3543" BorderThickness="0,0,1,0">
            <Grid Margin="14,20,14,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,22">
                    <Image Source="icon.ico" Width="38" Height="38" Margin="0,0,11,0" />
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="JustWatch" FontSize="19" FontWeight="SemiBold" Foreground="#F3F8FC" /><TextBlock Text="Your local workspace" FontSize="10.5" Foreground="#8495A9" Margin="0,4,0,0" /></StackPanel>
                </StackPanel>
                <ScrollViewer x:Name="ServiceTabs" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                    <StackPanel x:Name="TabBar" Orientation="Vertical" Margin="0,0,3,16" />
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="#2A3543" Margin="4,8,4,10" />
                    <Button x:Name="BtnSettings" Style="{StaticResource SidebarLink}" Click="Services_Click" ToolTip="Open JustWatch settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAbout" Style="{StaticResource SidebarLink}" Click="About_Click" ToolTip="Version, updates and links" AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="About" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button x:Name="BtnCommands" Style="{StaticResource WorkspaceButton}" Width="32" Height="34" Padding="0" Margin="0,0,6,0" HorizontalContentAlignment="Center" Click="Commands_Click" ToolTip="Commands" AutomationProperties.Name="Commands">
                            <Path Data="M 10,0 L 2,9 L 7,9 L 5,16 L 14,6 L 9,6 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnStartAll" Grid.Column="1" Content="Start all" Style="{StaticResource WorkspaceButton}" Height="34" Padding="6,8" Margin="0,0,4,0" Click="StartAll_Click" ToolTip="Start services configured for auto-start" />
                        <Button x:Name="BtnStopAll" Grid.Column="2" Content="Stop all" Style="{StaticResource WorkspaceButton}" Height="34" Padding="6,8" Margin="4,0,0,0" Click="StopAll_Click" />
                    </Grid>
                    <TextBlock x:Name="SidebarSummary" Text="Local services" Foreground="#8495A9" FontSize="10.5" Margin="10,12,0,4" />
                </StackPanel>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="Resize sidebar" />
        <Grid Grid.Column="2" Margin="24,16,24,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="#19232F" BorderBrush="#2A3847" BorderThickness="1,1,1,0" CornerRadius="9,9,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid x:Name="PageHeading" VerticalAlignment="Center" Margin="0,0,12,0" Height="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" MaxWidth="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Ellipse x:Name="SelectedStatusDot" Width="7" Height="7" Fill="#8BF0C6" Margin="0,0,8,0" />
                        <TextBlock x:Name="PageEyebrow" Grid.Column="1" Text="Workspace  /" FontSize="12" Foreground="#899BB1" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PageTitle" Grid.Column="2" Text="Your workspace" FontSize="13" FontWeight="SemiBold" Foreground="#EDF5FC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel x:Name="ProcessActionPanel" Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="BtnStartStop" Content="Start" Style="{StaticResource WorkspaceButton}" Padding="12,6" Margin="3,0" Click="StartStop_Click" />
                        <Button Content="Restart" Style="{StaticResource WorkspaceButton}" Padding="12,6" Margin="3,0" Click="Restart_Click" />
                        <Button Content="Clear" Style="{StaticResource WorkspaceButton}" Padding="12,6" Margin="3,0" Click="Clear_Click" ToolTip="Clear this terminal's visible output" />
                        <Button x:Name="BtnOpenService" Content="Open ↗" Style="{StaticResource WorkspaceButton}" Padding="12,6" Margin="3,0,0,0" Click="OpenService_Click" Visibility="Collapsed" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#10151C" BorderBrush="#2A3847" BorderThickness="1" CornerRadius="0,0,9,9" Padding="10,10,6,6">
                <wpf:WebView2 x:Name="TerminalWebView" DefaultBackgroundColor="#FF10151C" />
            </Border>
            <Grid Grid.Row="2" Margin="0,12,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Starting…" Foreground="#8A9AAF" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="StatusIndicators" Orientation="Horizontal" HorizontalAlignment="Right" /></ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
