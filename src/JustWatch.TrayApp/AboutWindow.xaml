<Window x:Class="JustWatch.TrayApp.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About JustWatch"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="/icon.ico"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        Foreground="#F4F4F5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#A5B4FC" />
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#4ADE80" />

        <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Window.Resources>

    <!-- The 16px margin is room for the shadow. -->
    <Grid x:Name="Shell" Margin="16">
        <Border Background="{StaticResource FlyoutBackgroundBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.55" BlurRadius="22" Direction="270" ShadowDepth="5" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource FlyoutBackgroundBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Drag area + close -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragMove">
                    <Button x:Name="CloseButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,10,10,0"
                            Content="&#xE711;"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Close"
                            Click="OnClose" />

                    <StackPanel Margin="24,28,24,0" HorizontalAlignment="Center">
                        <Image Source="/Assets/justwatch.png"
                               Width="64"
                               Height="64"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="16" RadiusY="16" />
                            </Image.Clip>
                        </Image>
                        <TextBlock Text="JustWatch"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />
                        <TextBlock Margin="0,14,0,0"
                                   MaxWidth="320"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Keeps your local dev servers running from the Windows tray. Start, stop and restart them in one click, read their logs, and see what else is listening on your machine." />
                    </StackPanel>
                </Grid>

                <!-- Update card -->
                <Border Grid.Row="1"
                        Margin="20,20,20,0"
                        Style="{StaticResource CardStyle}"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="UpdateDot"
                                 Width="8"
                                 Height="8"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource TertiaryTextBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle"
                                       Text="Updates"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateDetail"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource TertiaryTextBrush}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="UpdateButton"
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Content="Check now"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnUpdateClick" />
                    </Grid>
                </Border>

                <!-- Footer links -->
                <Border Grid.Row="2"
                        Margin="0,20,0,0"
                        Background="{StaticResource FooterBackgroundBrush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,13,13"
                        Padding="12,10">
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="GitHub" Style="{StaticResource LinkButtonStyle}" Click="OnGitHub" />
                        <Button Content="Releases" Style="{StaticResource LinkButtonStyle}" Click="OnReleaseNotes" />
                        <Button Content="Issues" Style="{StaticResource LinkButtonStyle}" Click="OnReportIssue" />
                        <Button Content="Config" Style="{StaticResource LinkButtonStyle}" Click="OnConfigFolder" />
                        <Button Content="AI agents" Style="{StaticResource LinkButtonStyle}" Click="OnAgentDocs" ToolTip="Agent docs and installable skill (llms.txt)" />
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
