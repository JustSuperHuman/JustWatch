<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>JustWatch</AssemblyName>
    <RootNamespace>JustWatch.TrayApp</RootNamespace>
    <Product>JustWatch</Product>
    <Title>JustWatch</Title>
    <Description>Local service and development workspace manager</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustWatch.Core\JustWatch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <!-- Agent docs next to JustWatch.exe, so an agent probing the install folder finds them. -->
  <ItemGroup>
    <None Include="..\..\llms.txt" Link="llms.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\llms.txt" Link="AGENTS.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\skills\justwatch\SKILL.md" Link="skills\justwatch\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <Resource Include="..\JustWatch.Core\Assets\justwatch.png" Link="Assets\justwatch.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <EmbeddedResource Include="Assets\Terminal\*.js;Assets\Terminal\*.css;Assets\Terminal\*.LICENSE"
                      LogicalName="JustWatch.TrayApp.TerminalAssets.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
